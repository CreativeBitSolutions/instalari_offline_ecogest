php_flag log_errors off
php_value error_reporting 0
php_value error_log "error_log.txt"

<IfModule mod_rewrite.c>
RewriteEngine On
# Taverna Amicii ruleaza pe SQLite offline: ruta Woo existenta foloseste importerul REST + inbox local.
RewriteRule ^vanzare_importa_comanda_woo\.php$ woo_offline_import.php [L,QSA]
</IfModule>
